#!/usr/bin/env php
<?php

declare(strict_types=1);

use FizzBuzz\FizzBuzz;

require dirname(__DIR__) . '/vendor/autoload.php';

$n = filter_var($argv[1] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]);

if ($n === false) {
    fwrite(STDERR, 'Usage: bin/fizzbuzz <N> (N: integer >= 1)' . PHP_EOL);
    exit(1);
}

foreach ((new FizzBuzz())->generate($n) as $result) {
    echo $result, PHP_EOL;
}
